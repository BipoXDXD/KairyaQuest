# ---- Python ----
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ---- Node ----
node_modules/
dist/
dist-ssr/
*.local
coverage/
playwright-report/
test-results/

# ---- Segredos ----
# .env.example é versionado de propósito (README §4).
.env
.env.*
!.env.example

# ---- IDE: estado pessoal ----
# .run/ NÃO entra aqui: é configuração compartilhada de execução (README §4).
.idea/
.vscode/*
!.vscode/extensions.json

# Worktrees efemeros de agentes, criados dentro do proprio repo.
# Apenas worktrees/: o resto de .claude/ pode conter configuracao de
# projeto versionada de proposito.
.claude/worktrees/

# ---- macOS ----
.DS_Store

# ---- Logs ----
logs/
*.log
npm-debug.log*

# Binarios de ferramenta baixados por scripts/
.tools/

# Scratch do processo de execucao dos agentes (planejamento, relatorios de
# tarefa). Precisa estar AQUI, na raiz versionada: .superpowers/sdd/.gitignore
# e ignorado pelo proprio "*" que declara, logo nao e versionado e nao chega
# em um clone. E esta linha que sustenta a isencao de .superpowers/sdd/ no
# .gitleaks.toml.
.superpowers/

# Artefatos OCI de publicação; não são imagens locais nem código-fonte.
.docker-artifacts/
