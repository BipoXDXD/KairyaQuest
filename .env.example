# Copie para .env. O .env e ignorado pelo git; este arquivo, nao.
# Porta 55432 no host: a 5432 esta ocupada por um PostgreSQL local que nao
# pertence a este projeto.
FOCUSQUEST_DB_PORT=55432
FOCUSQUEST_DATABASE_URL=postgresql+psycopg://focusquest:focusquest_local@127.0.0.1:55432/focusquest
# Banco de TESTE: o nome precisa terminar em _test (a guarda do DROP SCHEMA
# recusa qualquer outro). Cada worktree que roda o gate ao mesmo tempo que
# outro usa um banco PROPRIO, no mesmo servidor -- por exemplo
# focusquest_<nome>_test --, criado sozinho no primeiro uso (make reset-test-db
# ou a suite pytest). scripts/novo-worktree.sh escreve essa linha por voce.
FOCUSQUEST_TEST_DATABASE_URL=postgresql+psycopg://focusquest:focusquest_local@127.0.0.1:55432/focusquest_test

# Deslocamento das tres portas do E2E (API 8100, frontend 5273, falso 8150).
# Sem a linha, ou vazio, e 0: as portas de sempre. Inteiro de 0 a 49; por
# convencao, 0 a 24 para worktrees e 25 a 49 reservado ao pre-push (que usa o
# deslocamento do worktree + 25). scripts/novo-worktree.sh escolhe um livre.
# FOCUSQUEST_E2E_PORT_OFFSET=0

# Tutoria Groq Free. Mantenha a conta no plano Free, sem habilitar cobranca.
# Sem chave, Kairya fica indisponivel e o resto do app continua funcionando.
# Destino e modelo fixos: api.groq.com, openai/gpt-oss-20b. Sem fallback/retry.
# A chave NUNCA vai para o frontend, repositorio ou CI.
FOCUSQUEST_GROQ_API_KEY=
# Configuracao legada, aceita para compatibilidade; nao seleciona o modelo
# de producao, que e exclusivamente o Groq acima.
FOCUSQUEST_TUTOR_MODEL=openai/gpt-oss-20b
FOCUSQUEST_TUTOR_MAX_TOKENS=2048
FOCUSQUEST_TUTOR_TIMEOUT_SECONDS=60
FOCUSQUEST_TUTOR_HISTORY_MESSAGES=20
# Legado: ignorado em producao, inclusive se alguem deixar true num .env antigo.
FOCUSQUEST_TUTOR_FALLBACK=false

# Nivel de log do app (logger focusquest): DEBUG, INFO, WARNING, ERROR ou
# CRITICAL, em qualquer caixa. Sem a linha, ou vazio, e INFO. Vale so para o
# app: o DEBUG do httpx, do SDK da Anthropic e do SQLAlchemy continua
# desligado (docs/ARCHITECTURE.md, "Logging").
FOCUSQUEST_LOG_LEVEL=INFO
